# Python / uv
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Created by `uv sync` on each machine. It contains the Claude Code CLI bundled in
# claude-agent-sdk, which is downloaded from PyPI per machine and never redistributed here.
# (.venv/ above already covers it; this note is the reason.)

# Machine- and user-specific state: chats, settings, cloud instance record, trash,
# attachments, logs. Never commit.
runtime/

# The agent's default working folder: your models and scripts live here.
sandbox/workdir/*
!sandbox/workdir/.gitkeep

# User-created skills, commands, subagents and MCP servers (created on first use).
userplugins/*
!userplugins/README.md

# CAD output that may land elsewhere in the tree
*.FCStd
*.FCBak
*.FCStd1

# Keys and local secrets, belt and braces
*.pem
*_ed25519
*_ed25519.pub
.env
.env.*
